# Copy to web/.env and fill in. See docs/web/README.md.

# The address people open; used in invitation links. Must be https:// in production.
PUBLIC_URL=https://quran.example.org
# For the optional Caddy HTTPS proxy (docker compose --profile https): the domain only.
DOMAIN=quran.example.org

# 32+ random characters, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=
# The database password (docker compose creates the database with it).
POSTGRES_PASSWORD=

NODE_ENV=production
# 1 when the app runs behind one reverse proxy (Caddy, nginx), so rate limits see real addresses.
TRUST_PROXY=1

# Optional: send invitations by email. Without it, the person inviting shares the link.
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM="الجمعية القرآنية <no-reply@example.org>"

# Optional tuning (defaults shown).
# SESSION_IDLE_HOURS=12
# SESSION_MAX_HOURS=72
# INVITE_DAYS=7
# MAX_UPLOAD_MB=50
# BACKUP_KEEP_DAYS=14
# APP_PORT=8080
