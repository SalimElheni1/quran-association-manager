# This is an example file. Copy it to .env and fill in your local values.
# DO NOT COMMIT the .env file to version control.

# Login of the demo superadmin created by `npm run seed:manual` (development only).
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="your-strong-default-password"

# Set to 1 to accept any non-empty password in `npm run dev` (throwaway test accounts).
# Development only: the installed app ignores it. Leave it off when working on real data.
QBM_RELAXED_PASSWORDS=0
